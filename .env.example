# Database URL for PostgreSQL (Required)
# For local development: postgresql://user:password@localhost:5432/transcriptor
# For Vercel: Will be auto-set when you add Vercel Postgres storage
DATABASE_URL=postgresql://user:password@localhost:5432/transcriptor

# Anthropic API Key for Claude (Required for analysis)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API Key for Whisper (Required for audio upload/transcription)
OPENAI_API_KEY=sk-your-key-here

# NextAuth Configuration (Required for  authentication)
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Optional - only if you want Google login)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Vercel Blob Storage (Required for production audio storage)
# Auto-configured when you add Vercel Blob storage to your project
# For local dev, create a Blob store in Vercel dashboard and copy the token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxx

# Resend (Optional - only for email notifications)
# Get your API key from: https://resend.com/api-keys
# If not set, email features will be disabled (app will still work)
RESEND_API_KEY=re_xxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
